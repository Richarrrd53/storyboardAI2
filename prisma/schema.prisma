generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id           String   @id @default(uuid())
  shortId      String   @unique
  authorId     String?
  author       User?    @relation(fields: [authorId], references: [id])
  title        String
  style        String
  ratio        String
  cover        String?  
  metadata     Json?
  characters   Json?
  shots        Shot[]
  is_deleted   Boolean   @default(false)
  deletedAt    DateTime?
  createAt     DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([authorId])
  @@index([authorId, is_deleted, createAt])
  @@index([is_deleted, deletedAt])
  @@index([authorId, is_deleted, deletedAt])
}

model CleanupJob {
  id           String    @id @default(uuid())
  projectId    String    @unique
  authorId     String?
  reason       String
  status       String    @default("pending")
  storagePaths Json      @default("[]")
  deletedPaths Json      @default("[]")
  dbDeleted    Boolean   @default(false)
  attempts     Int       @default(0)
  lastError    String?
  lockedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, updatedAt])
}

model Shot {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order     Int
  title     String
  camera    String
  duration  String
  payload   Json
  createAt  DateTime @default(now())
  updateAt  DateTime @updatedAt
}

model User {
  id             String              @id @default(uuid())
  name           String?
  email          String              @unique
  passwordHash   String
  image          String?
  plan           String              @default("free")
  aiProvider     String              @default("gemini")
  project        Project[]
  apiCredentials UserApiCredential[]
  createAt       DateTime            @default(now())
}

model UserApiCredential {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String
  encryptedKey String
  iv           String
  authTag      String
  keyVersion   String   @default("v1")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId])
}

model Template {
  id          String   @id
  name        String
  category    String
  tags        Json
  description String?
  content     Json
  is_custom   Boolean  @default(false)
  createAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt
}