{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/discovery/settings",
      "destination": "/main.html"
    },
    {
      "source": "/discovery",
      "destination": "/main.html"
    },
    {
      "source": "/(.*)",
      "destination": "/main.html"
    }
  ]
}
